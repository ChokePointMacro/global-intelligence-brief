# ── AI providers (at least one required; fallback order is claude -> gpt) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── App ──
APP_URL="http://localhost:3000"
SESSION_SECRET=

# ── X / Twitter OAuth 2.0 (confidential client: both required) ──
# Portal -> your app -> Keys and tokens -> "OAuth 2.0 Client ID and Client Secret".
# NOT the Consumer Keys, and NOT the Authentication Tokens — all three look alike and
# all three secrets are ~50 chars. Using the wrong one gives a 401 at token exchange
# while authorisation still appears to succeed.
X_CLIENT_ID=
X_CLIENT_SECRET=

# ── X analytics (App-Only Bearer, for the weekly audience sampler) ──
# Portal -> your app -> Keys and tokens -> Authentication Tokens -> Bearer Token.
X_BEARER_TOKEN=

# ── Publisher safety rails ──
# POSTING_ENABLED is FAIL-CLOSED: anything other than the literal 'true' means posting is
# off. An unset or misspelled variable therefore produces silence rather than a live
# account publishing on a timer. app_settings.posting_enabled (the UI toggle, via
# PUT /api/posting/status) overrides this and takes effect without a restart.
POSTING_ENABLED=false         # master kill switch for all scheduled posting
POSTING_DRY_RUN=false         # true = log what would post, send nothing
MAX_POSTS_PER_RUN=5           # cap per cron tick; excess is deferred and logged, not dropped
POST_CLAIM_TIMEOUT_MIN=10     # rows stranded in 'posting' are failed (not retried) after this
POST_MAX_LATE_MIN=30          # a slot more than this far past due is SKIPPED, not published.
                              # Stops a sleeping laptop dumping a stale backlog on wake.
POST_SOURCE_AS_REPLY=false    # cite source in a reply, avoiding the link reach penalty.
                              # Costs one extra billed post ($0.20, link rate).
X_MAX_POST_CHARS=25000        # X Premium long-form ceiling; set 280 to enforce free tier

# ── Scheduling ──
# All slot times are Eastern (America/New_York) and DST-aware: the content is keyed to US
# market hours, and the machine running this is not on Eastern time.
REPORT_MAX_LATE_MIN=360       # a report this far past its slot is skipped for the day

# ── AI spend cap ──
# Hard pre-flight limit, enforced across the provider fallback chain AND the direct SDK
# calls in markets.ts. Month-to-date, calendar month, X posting costs excluded.
# Warns by email at 80%, refuses further calls at 100%. 0 disables the cap.
AI_MONTHLY_CAP_USD=80

# ── Backups ──
BACKUP_DIR=backups            # nightly VACUUM INTO snapshots; point at Drive or an external disk
BACKUP_KEEP=14                # rolling retention, in daily snapshots

# ── Local mode ──
LOCAL_MODE=true               # bypass auth + bind loopback only. false restores login and 0.0.0.0
LOCAL_USER_ID=                # defaults to m@aol.com

# ── Generation ──
REPORT_TIMEOUT_MS=480000      # 8 min. Generation is two sequential AI calls (report, then
                              # the hashtag reach pass) — 3 min timed out mid-flight.

# ── Public share links (optional) ──
PUBLIC_ACCOUNT_ID=
PUBLIC_SECRET_KEY=
